+def _tokenizer_encode_without_special_tokens(tokenizer: Any, text: str) -> list[int]:
+    targets = [tokenizer]
+    inner = getattr(tokenizer, "tokenizer", None)
+    if inner is not None:
+        targets.append(inner)
+    for target in targets:
+        encode = getattr(target, "encode", None)
+        if encode is None:
+            continue
+        try:
+            return [int(token) for token in encode(text, add_special_tokens=False)]
+        except TypeError:
+            return [int(token) for token in encode(text)]
+    if callable(tokenizer):
+        try:
+            out = tokenizer(text, add_special_tokens=False)
+        except TypeError:
+            out = tokenizer(text)
+        if isinstance(out, dict) and "input_ids" in out:
+            return [int(token) for token in out["input_ids"]]
+        return [int(token) for token in out]
+    raise RuntimeError("tokenizer has no encode interface")
+
+
+def _tokenizer_vocabulary_token_ids(tokenizer: Any) -> list[int]:
+    targets = [tokenizer]
+    inner = getattr(tokenizer, "tokenizer", None)
+    if inner is not None:
+        targets.append(inner)
+    for target in targets:
+        get_vocab = getattr(target, "get_vocab", None)
+        if get_vocab is not None:
+            vocab = get_vocab()
+            if isinstance(vocab, dict) and vocab:
+                return sorted({int(token_id) for token_id in vocab.values()})
+        vocab_size = getattr(target, "vocab_size", None)
+        if vocab_size is not None:
+            return list(range(int(vocab_size)))
+    raise RuntimeError("tokenizer has no vocabulary enumeration interface")
+
+
+def _token_ids_decoding_with_prefix(tokenizer: Any, prefix: str) -> list[int]:
+    token_ids = [
+        token_id
+        for token_id in _tokenizer_vocabulary_token_ids(tokenizer)
+        if _tokenizer_decode(tokenizer, [token_id]).startswith(prefix)
+    ]
+    if not token_ids:
+        raise RuntimeError(f"no tokenizer tokens decode with prefix {prefix!r}")
+    return token_ids
+
+
+def _speaker_self_tag_paths(
+    tokenizer: Any,
+    speaker: str,
+    *,
+    colon_start_token_ids: list[int],
+) -> dict[str, Any]:
+    """Derive exact leading own-name and own-tag token paths."""
+
+    def variants(suffix: str) -> list[dict[str, Any]]:
+        paths: list[dict[str, Any]] = []
+        seen: dict[tuple[int, ...], dict[str, Any]] = {}
+        for label, prefix in (
+            ("no_leading_space", ""),
+            ("leading_space", " "),
+        ):
+            token_ids = _tokenizer_encode_without_special_tokens(
+                tokenizer,
+                f"{prefix}{speaker}{suffix}",
+            )
+            if not token_ids:
+                raise RuntimeError(
+                    f"speaker-tag variant produced no tokens: {prefix + speaker + suffix!r}"
+                )
+            key = tuple(token_ids)
+            if key in seen:
+                seen[key]["variants"].append(label)
+                continue
+            row = {
+                "variants": [label],
+                "token_ids": token_ids,
+            }
+            seen[key] = row
+            paths.append(row)
+        return paths
+
+    return {
+        "speaker": speaker,
+        "name_paths": variants(""),
+        "encoded_tag_paths": variants(":"),
+        "colon_start_token_ids": sorted(
+            {int(token_id) for token_id in colon_start_token_ids}
+        ),
+    }
+
+
+def _path_is_prefix(prefix: list[int], path: list[int]) -> bool:
+    return len(prefix) <= len(path) and path[:len(prefix)] == prefix
+
+
+def _matching_self_tag_paths(
+    prefix: list[int],
+    tag_paths: dict[str, Any],
+) -> list[str]:
+    matches: list[str] = []
+    for row in tag_paths["encoded_tag_paths"]:
+        path = [int(token_id) for token_id in row["token_ids"]]
+        if len(prefix) < len(path) and _path_is_prefix(prefix, path):
+            matches.extend(f"encoded_tag:{variant}" for variant in row["variants"])
+    for row in tag_paths["name_paths"]:
+        path = [int(token_id) for token_id in row["token_ids"]]
+        if _path_is_prefix(prefix, path):
+            matches.extend(
+                f"name_then_colon:{variant}" for variant in row["variants"]
+            )
+    return sorted(set(matches))
+
+
+def _self_tag_completion_token_ids(
+    prefix: list[int],
+    tag_paths: dict[str, Any],
+) -> list[int]:
+    token_ids: set[int] = set()
+    for row in tag_paths["encoded_tag_paths"]:
+        path = [int(token_id) for token_id in row["token_ids"]]
+        if path and prefix == path[:-1]:
+            token_ids.add(path[-1])
+    for row in tag_paths["name_paths"]:
+        path = [int(token_id) for token_id in row["token_ids"]]
+        if prefix == path:
+            token_ids.update(
+                int(token_id)
+                for token_id in tag_paths["colon_start_token_ids"]
+            )
+    return sorted(token_ids)
+
+
+def _mask_token_ids_in_logprobs(logprobs: Any, token_ids: list[int]) -> Any:
+    """Return a masked copy, preserving the unmasked vector for D0 metrics."""
+    import mlx.core as mx
+
+    vocab_size = int(logprobs.shape[-1])
+    vocab_indices = mx.arange(vocab_size)
+    masked = logprobs
+    negative_infinity = mx.array(-float("inf"), dtype=logprobs.dtype)
+    for token_id in token_ids:
+        if token_id < 0 or token_id >= vocab_size:
+            raise RuntimeError(
+                f"self-tag completion token id {token_id} is outside vocabulary size {vocab_size}"
+            )
+        masked = mx.where(vocab_indices == int(token_id), negative_infinity, masked)
+    return masked
+
+
+def _sampled_token_id(sampled: Any) -> int:
+    item = getattr(sampled, "item", None)
+    return int(item()) if item is not None else int(sampled)
+
+
+def _make_self_tag_prefix_tracking_sampler(
+    sampler: Any,
+    tag_paths: dict[str, Any],
+) -> Any:
+    """Block only a token that would complete an exact leading own-tag path."""
+    emitted_prefix: list[int] = []
+    pending_sampled: Optional[Any] = None
+    tracking = True
+
+    def sample(logprobs: Any) -> Any:
+        nonlocal pending_sampled, tracking
+        if tracking and pending_sampled is not None:
+            emitted_prefix.append(_sampled_token_id(pending_sampled))
+            pending_sampled = None
+            if not _matching_self_tag_paths(emitted_prefix, tag_paths):
+                tracking = False
+        masked_token_ids = (
+            _self_tag_completion_token_ids(emitted_prefix, tag_paths)
+            if tracking
+            else []
+        )
+        sampling_logprobs = (
+            _mask_token_ids_in_logprobs(logprobs, masked_token_ids)
+            if masked_token_ids
+            else logprobs
+        )
+        sampled = sampler(sampling_logprobs)
+        if tracking:
+            pending_sampled = sampled
+        return sampled
+
+    return sample
+
+
+def _self_tag_prefix_tracking_audit(
+    tag_paths: dict[str, Any],
+    generated_token_ids: list[int],
+) -> dict[str, Any]:
+    """Reconstruct the exact prefix states and mask events for one turn."""
+    prefix: list[int] = []
+    states: list[dict[str, Any]] = []
+    mask_events: list[dict[str, Any]] = []
+    diverged_at_step: Optional[int] = None
+    tracking = True
+
+    for generation_step, sampled_token_id in enumerate(generated_token_ids):
+        matching_paths = _matching_self_tag_paths(prefix, tag_paths)
+        if not matching_paths:
+            tracking = False
+            break
+        masked_token_ids = _self_tag_completion_token_ids(prefix, tag_paths)
+        states.append(
+            {
+                "generation_step": generation_step,
+                "prefix_token_ids": list(prefix),
+                "matching_paths": matching_paths,
+                "sampled_token_id": int(sampled_token_id),
+            }
+        )
+        if masked_token_ids:
+            mask_events.append(
+                {
+                    "generation_step": generation_step,
+                    "prefix_token_ids": list(prefix),
+                    "masked_token_ids": masked_token_ids,
+                }
+            )
+            if int(sampled_token_id) in masked_token_ids:
+                raise RuntimeError(
+                    "self-tag prefix constraint was bypassed: "
+                    f"generation_step={generation_step}, "
+                    f"token_id={sampled_token_id}"
+                )
+        prefix.append(int(sampled_token_id))
+        if not _matching_self_tag_paths(prefix, tag_paths):
+            tracking = False
+            diverged_at_step = generation_step
+            break
+
+    return {
+        "speaker": str(tag_paths["speaker"]),
+        "name_paths": [
+            {
+                "variants": list(row["variants"]),
+                "token_ids": [int(token_id) for token_id in row["token_ids"]],
+            }
+            for row in tag_paths["name_paths"]
+        ],
+        "encoded_tag_paths": [
+            {
+                "variants": list(row["variants"]),
+                "token_ids": [int(token_id) for token_id in row["token_ids"]],
+            }
+            for row in tag_paths["encoded_tag_paths"]
+        ],
+        "colon_start_token_ids": [
+            int(token_id)
+            for token_id in tag_paths["colon_start_token_ids"]
+        ],
+        "states_visited": states,
+        "mask_events": mask_events,
+        "sampling_was_constrained": bool(mask_events),
+        "diverged_at_generation_step": diverged_at_step,
+        "ended_while_matching_tag_prefix": bool(
+            tracking and _matching_self_tag_paths(prefix, tag_paths)
+        ),
+    }
+
+
